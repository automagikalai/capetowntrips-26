# Enquiry form email, sent with Resend (resend.com). Required in production.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Cape Town Trips <enquiries@capetowntrips.com>"
ENQUIRY_FROM=
# Where enquiries are delivered (defaults to hello@capetowntrips.com)
ENQUIRY_TO=

# Set to 1 to show "photo coming soon" placeholders on a live build (private preview). Remove once photos are in.
SHOW_PLACEHOLDERS=

# Set to 1 on any staging or preview site so search engines ignore it. Leave unset on the live site.
# (Vercel preview deployments are hidden automatically.)
NOINDEX=
